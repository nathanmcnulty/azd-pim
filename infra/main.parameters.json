{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "pimMode": { "value": "${AZD_PIM_MODE=plan}" },
    "notificationMode": { "value": "${AZD_PIM_NOTIFICATION_MODE=none}" },
    "teamsWebhookUrl": { "value": "${AZD_PIM_TEAMS_WEBHOOK_URL}" },
    "sentinelWorkspaceResourceId": { "value": "${AZD_PIM_SENTINEL_WORKSPACE_RESOURCE_ID}" },
    "sentinelWorkspaceLocation": { "value": "${AZD_PIM_SENTINEL_WORKSPACE_LOCATION}" },
    "pollingSchedule": { "value": "${AZD_PIM_POLLING_SCHEDULE=0 */5 * * * *}" },
    "pollingLookbackMinutes": { "value": "${AZD_PIM_POLLING_LOOKBACK_MINUTES=30}" },
    "pollingSendInitialLookback": { "value": "${AZD_PIM_POLLING_SEND_INITIAL_LOOKBACK=false}" },
    "enableSessionRevocation": { "value": "${AZD_PIM_ENABLE_SESSION_REVOCATION=false}" },
    "revocationFailureBehavior": { "value": "${AZD_PIM_REVOCATION_FAILURE_BEHAVIOR=deny}" },
    "revocationAlertActionGroupResourceId": { "value": "${AZD_PIM_REVOCATION_ALERT_ACTION_GROUP_RESOURCE_ID}" }
  }
}
